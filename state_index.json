# INDEX SIGNAL BOT v2 -- NIFTY 15m + SENSEX 15m + NASDAQ 1H, ek hi file
# Github par file ka naam:  .github/workflows/index.yml
# v1 se badla: 15m timeframe, session-clock fix, 14:30 entry gate, 2-min cron
name: Index Alerts v2

on:
  schedule:
    - cron: '*/2 * * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4

      - name: Bot chalayein
        env:
          TG_TOKEN: ${{ secrets.TG_TOKEN }}
          TG_CHAT: ${{ secrets.TG_CHAT }}
          ACCOUNT_BALANCE: ${{ vars.ACCOUNT_BALANCE }}
          RISK_PERCENT: ${{ vars.RISK_PERCENT }}
        run: |
          cat > /tmp/bot.py <<'ENDOFPY'
          import json, math, os, time, urllib.request, urllib.parse
          from datetime import datetime, timezone, timedelta

          IST = timezone(timedelta(hours=5, minutes=30))

          TG = os.environ.get('TG_TOKEN', '')
          CH = os.environ.get('TG_CHAT', '')
          BAL = float(os.environ.get('ACCOUNT_BALANCE') or 1000)
          RP = float(os.environ.get('RISK_PERCENT') or 0.5)
          STATE = 'state_index_v2.json'
          TPCT = 0.001

          # --- test hooks (production mein khali rehte hain, koi asar nahi) ---
          FAKE_NOW = os.environ.get('FAKE_NOW')          # epoch seconds, replay test ke liye
          OFFLINE = os.environ.get('OFFLINE_JSON')       # cached Yahoo JSON folder

          # ---------------------------------------------------------------------------
          # OPTION MODE -- 3-din expiry ATM CE/PE
          # 60-din test: NIFTY PF 1.59 / SENSEX PF 1.54 (spread + IV crush ke baad bhi)
          # 7-din aur 30-din NAHI: IV crush se PF 0.74 / 0.55 par gir jaata hai.
          # ---------------------------------------------------------------------------
          # ---------------------------------------------------------------------------
          # AUTO EXPIRY
          # NIFTY weekly = Tuesday, SENSEX weekly = Thursday (SEBI rule, Sep 2025 se).
          # Holiday ho to expiry pichle TRADING din par. 0-1 din bache ho to agla hafta.
          # Holiday source 3 layer: 2026 official + 2027 estimate + bars se auto-detect.
          # ---------------------------------------------------------------------------
          EXPIRY_WD = {'NIFTY 50': 1, 'SENSEX': 3}
          SUPPORTED_YEARS = {2026, 2027}

          HOLIDAYS = {
              # ---- 2026 : NSE official (equity + F&O) -------------------------------
              '2026-01-26', '2026-03-03', '2026-03-26', '2026-03-31', '2026-04-03',
              '2026-04-14', '2026-05-01', '2026-05-28', '2026-06-26', '2026-09-14',
              '2026-10-02', '2026-10-20', '2026-11-10', '2026-11-24', '2026-12-25',
              # ---- 2027 : NSE ne official publish NAHI kiya -- ye ESTIMATE hain -----
              '2027-01-26', '2027-03-10', '2027-03-22', '2027-03-26', '2027-04-14',
              '2027-04-15', '2027-04-19', '2027-05-17', '2027-06-15', '2027-10-29',
          }
          IV_OPT = 0.11
          RATE = 0.065
          PSL = 0.30   # premium stop-loss: exit at -30% of entry premium
          PTP = 0.60   # premium take-profit: exit at +60% of entry premium


          def _closed_days(B):
              """Pichle 60 din ke bars se khud pata karo kaunse working days band the."""
              if not B or len(B) < 200:
                  return set()
              days = sorted({datetime.fromtimestamp(b['t'], IST).date() for b in B})
              if len(days) < 25:
                  return set()
              have = set(days)
              out = set()
              d = days[0] + timedelta(days=1)          # pehla din adhura ho sakta hai
              last = days[-1] - timedelta(days=1)      # aaj ka din adhura hai
              while d <= last:
                  if d.weekday() < 5 and d not in have:
                      out.add(d.isoformat())
                  d += timedelta(days=1)
              return out


          def _prev_trading_day(d, extra):
              while d.weekday() >= 5 or d.isoformat() in HOLIDAYS or d.isoformat() in extra:
                  d -= timedelta(days=1)
              return d


          def _expiry_candidates(today, wd, extra, span=25):
              out = []
              for k in range(span):
                  cand = today + timedelta(days=k)
                  if cand.weekday() != wd:
                      continue
                  out.append(_prev_trading_day(cand, extra))
              return sorted(set(out))


          def expiry_for(name, now_dt, B=None):
              """(expiry date, din bache, note). 0-1 din wala contract nahi lete."""
              wd = EXPIRY_WD.get(name)
              if wd is None:
                  return None, 3, ''
              extra = _closed_days(B) if B else set()
              today = now_dt.date()
              c = [d for d in _expiry_candidates(today, wd, extra) if d >= today]
              notes = []
              if now_dt.year not in SUPPORTED_YEARS:
                  notes.append('{} ki holiday list purani hai -- expiry date broker se confirm karein'
                               .format(now_dt.year))
              if not c:
                  return None, 3, ' · '.join(notes)
              d0 = c[0]
              dte = (d0 - today).days
              if dte <= 1 and len(c) > 1:
                  notes.append('{} ({} din) skip -- theta bahut tez'.format(d0.strftime('%d-%b'), dte))
                  d0 = c[1]
                  dte = (d0 - today).days
              return d0, dte, ' · '.join(notes)


          def _Nd(x):
              return 0.5 * (1 + math.erf(x / math.sqrt(2)))


          def bs(S, K, T, iv, call):
              """Black-Scholes. Sirf estimate -- asli quote se +/-40% farak ho sakta hai."""
              if T <= 0:
                  return max(S - K, 0.0) if call else max(K - S, 0.0)
              d1 = (math.log(S / K) + (RATE + iv * iv / 2.0) * T) / (iv * math.sqrt(T))
              d2 = d1 - iv * math.sqrt(T)
              if call:
                  return S * _Nd(d1) - K * math.exp(-RATE * T) * _Nd(d2)
              return K * math.exp(-RATE * T) * _Nd(-d2) - S * _Nd(-d1)


          def opt_leg(spot, strike, days_left, call):
              return bs(spot, strike, max(days_left, 0.25) / 365.0, IV_OPT, call)


          def now_ts():
              return float(FAKE_NOW) if FAKE_NOW else time.time()

          # ---------------------------------------------------------------------------
          # NIFTY / SENSEX  : 15m, session 09:15-15:30 IST, last entry bar 14:15
          # NASDAQ          : 1H,  ~23 ghante chalta hai, koi session gate nahi
          #
          # SL 3xATR, RR 1:2, no ADX filter  <-- 15m par yahi best nikla (24 configs)
          # tstop = wall-clock minutes (parity with backtest)
          # ---------------------------------------------------------------------------
          MARKETS = [
              dict(name='NIFTY 50', sym='^NSEI', interval='15m', rng='60d', bar_min=15,
                   ef=9, es=50, sl=3.0, lb=3, adx=0, rr=2.0, tstop=25, catchup=200,
                   sess=(9 * 60 + 15, 15 * 60 + 30), gate=14 * 60 + 30, maxdelay=45,
                   units=[('Fut 1 lot', 65, 'INR')], opt=(65, 50, 3),
                   note='NIFTY lot = 65 qty. Option: OTM3, auto expiry (Tuesday).',
                   verified='PF 1.50 | 57 trades | 49.1% WR | 60 din | 3/4 fold pass'),

              dict(name='SENSEX', sym='^BSESN', interval='15m', rng='60d', bar_min=15,
                   ef=9, es=200, sl=3.0, lb=3, adx=0, rr=2.0, tstop=25, catchup=200,
                   sess=(9 * 60 + 15, 15 * 60 + 30), gate=14 * 60 + 30, maxdelay=45,
                   units=[('Fut 1 lot', 20, 'INR')], opt=(20, 100, 3),
                   note='SENSEX lot = 20 qty. Option: OTM3, auto expiry (Thursday).',
                   verified='PF 1.40 | 57 trades | 49.1% WR | 60 din | 4/4 fold pass'),

              dict(name='NASDAQ 100', sym='NQ=F', interval='60m', rng='6mo', bar_min=60,
                   ef=9, es=50, sl=2.5, lb=3, adx=0, rr=2.0, tstop=40, catchup=48,
                   sess=None, gate=None, maxdelay=90,
                   units=[('MNQ', 2, 'USD'), ('NQ', 20, 'USD')],
                   note='MNQ min size mehnga hai. Broker NAS100 CFD (fractional lot) deta hai to wahi lein.',
                   verified='PF 1.18 | 497 trades | 43.5% WR'),
          ]


          def get(url):
              if OFFLINE:
                  key = (url.split('/chart/')[1].split('?')[0].replace('%', '_')
                         + '_' + url.split('interval=')[1].split('&')[0])
                  return json.load(open(os.path.join(OFFLINE, key + '.json')))
              r = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
              return json.loads(urllib.request.urlopen(r, timeout=30).read())


          def send(txt, dry=''):
              print(txt)
              print()
              if not (TG and CH) or os.environ.get('DRY_RUN') == '1':
                  return
              data = urllib.parse.urlencode({'chat_id': CH, 'text': txt, 'parse_mode': 'HTML',
                                             'disable_web_page_preview': 'true'}).encode()
              try:
                  urllib.request.urlopen('https://api.telegram.org/bot' + TG + '/sendMessage',
                                         data=data, timeout=20)
              except Exception as e:
                  print('telegram error:', e)


          def ema(v, n):
              r = [None] * len(v)
              if len(v) < n:
                  return r
              k, p = 2 / (n + 1), sum(v[:n]) / n
              r[n - 1] = p
              for i in range(n, len(v)):
                  p = v[i] * k + p * (1 - k)
                  r[i] = p
              return r


          def rma(v, n):
              r = [None] * len(v)
              if len(v) < n:
                  return r
              p = sum(v[:n]) / n
              r[n - 1] = p
              for i in range(n, len(v)):
                  p = (p * (n - 1) + v[i]) / n
                  r[i] = p
              return r


          # --------------------------- session clock ---------------------------------
          def ist_min(ts):
              d = datetime.fromtimestamp(ts, IST)
              return d.hour * 60 + d.minute


          def close_ts_of_day(ts, sess):
              """Us din ka session close (epoch seconds), IST ke hisaab se."""
              d = datetime.fromtimestamp(ts, IST)
              c = d.replace(hour=sess[1] // 60, minute=sess[1] % 60, second=0, microsecond=0)
              return int(c.timestamp())


          def open_ts_of_day(ts, sess):
              d = datetime.fromtimestamp(ts, IST)
              o = d.replace(hour=sess[0] // 60, minute=sess[0] % 60, second=0, microsecond=0)
              return int(o.timestamp())


          def bar_end(M, t):
              """Bar asli mein kab band hota hai. NSE ka last bar 15:30 par band hota hai,
              chahe uska label 15:15 ho -- 3600 jodna galat tha."""
              end = t + M['bar_min'] * 60
              if M['sess']:
                  end = min(end, close_ts_of_day(t, M['sess']))
              return end


          def market_open(M, now):
              if not M['sess']:
                  return True
              return open_ts_of_day(now, M['sess']) <= now < close_ts_of_day(now, M['sess'])


          def live_price(M):
              """Abhi ka bhav. Alert late hai ya nahi -- yeh check karne ke liye."""
              try:
                  d = get('https://query1.finance.yahoo.com/v8/finance/chart/' + M['sym']
                          + '?interval=1m&range=1d')
                  res = d['chart']['result'][0]
                  q = res['indicators']['quote'][0]
                  for i in range(len(res['timestamp']) - 1, -1, -1):
                      c = q['close'][i]
                      if c and c > 0:
                          return float(c)
              except Exception as e:
                  print('live price fail:', e)
              return None


          def bars_for(M):
              d = get('https://query1.finance.yahoo.com/v8/finance/chart/' + M['sym']
                      + '?interval=' + M['interval'] + '&range=' + M['rng'])
              res = d['chart']['result'][0]
              q = res['indicators']['quote'][0]
              now = now_ts()
              B = []
              for i, t in enumerate(res['timestamp']):
                  o, h, l, c = q['open'][i], q['high'][i], q['low'][i], q['close'][i]
                  if None in (o, h, l, c) or c <= 0:
                      continue
                  if M['sess'] and ist_min(t) >= M['sess'][1]:
                      continue                      # 15:30 ka stub bar -- phenk do
                  if bar_end(M, t) > now:
                      continue                      # abhi band nahi hua
                  B.append({'t': t, 'o': o, 'h': h, 'l': l, 'c': c})
              return B


          def indicators(B, ef, es):
              C = [b['c'] for b in B]; H = [b['h'] for b in B]; L = [b['l'] for b in B]
              fE, sE, tE = ema(C, ef), ema(C, es), ema(C, 200)
              tr = [H[0] - L[0]] + [max(H[i] - L[i], abs(H[i] - C[i - 1]), abs(L[i] - C[i - 1]))
                                    for i in range(1, len(C))]
              A = rma(tr, 14)
              gl = [0.0] + [max(C[i] - C[i - 1], 0) for i in range(1, len(C))]
              ls = [0.0] + [max(C[i - 1] - C[i], 0) for i in range(1, len(C))]
              u, dn = rma(gl, 14), rma(ls, 14)
              RSI = [None if (u[i] is None or dn[i] is None)
                     else (100.0 if dn[i] == 0 else 100 - 100 / (1 + u[i] / dn[i]))
                     for i in range(len(C))]
              up = [0.0] + [H[i] - H[i - 1] for i in range(1, len(C))]
              dw = [0.0] + [L[i - 1] - L[i] for i in range(1, len(C))]
              plus = [up[i] if (up[i] > dw[i] and up[i] > 0) else 0.0 for i in range(len(C))]
              minus = [dw[i] if (dw[i] > up[i] and dw[i] > 0) else 0.0 for i in range(len(C))]
              rp_, rm_ = rma(plus, 14), rma(minus, 14)
              PDI = [None if (rp_[i] is None or not A[i]) else 100 * rp_[i] / A[i] for i in range(len(C))]
              MDI = [None if (rm_[i] is None or not A[i]) else 100 * rm_[i] / A[i] for i in range(len(C))]
              DX = [0.0 if (PDI[i] is None or (PDI[i] + MDI[i]) == 0)
                    else 100 * abs(PDI[i] - MDI[i]) / (PDI[i] + MDI[i]) for i in range(len(C))]
              return C, fE, sE, tE, A, RSI, rma(DX, 14)


          def hm(mins):
              h, m = int(mins // 60), int(mins % 60)
              return (str(h) + 'h ' if h else '') + str(m) + 'm'


          # ---------------------------------------------------------------------------
          st = {}
          if os.path.exists(STATE):
              try:
                  st = json.load(open(STATE))
              except Exception:
                  st = {}
          changed = False
          now = now_ts()

          for M in MARKETS:
              name = M['name']
              tf = M['interval']
              # holiday guard: NSE band ho to koi signal nahi (10-Nov, 24-Nov, 25-Dec ...)
              if M.get('sess') and datetime.fromtimestamp(now, IST).date().isoformat() in HOLIDAYS:
                  print(name, 'HOLIDAY -- market band, koi signal nahi')
                  continue
              try:
                  B = bars_for(M)
              except Exception as e:
                  print(name, 'data error:', e)
                  continue
              need = max(M['es'], 200) + 60
              if len(B) < need:
                  print(name, 'not enough bars:', len(B), '<', need)
                  continue

              C, fE, sE, tE, A, RSI, ADX = indicators(B, M['ef'], M['es'])
              ms = st.setdefault(name, {'last': None, 'trade': None, 'tf': tf})

              if ms.get('tf') != tf:                    # timeframe badla -> purana trade radd
                  ms['last'] = None
                  ms['trade'] = None
                  ms['tf'] = tf
                  changed = True

              start = 0
              if ms.get('last') is None:
                  start = max(0, len(B) - 1)
              else:
                  while start < len(B) and B[start]['t'] <= ms['last']:
                      start += 1
                  if len(B) - start > M['catchup']:
                      start = len(B) - M['catchup']
              if start >= len(B):
                  print('{}: nothing new'.format(name))
                  continue

              print('{}: {} bar(s) scan'.format(name, len(B) - start))
              fired = 0
              skipped_late = 0

              for i in range(start, len(B)):
                  bar = B[i]
                  fe, se, te, a, r, ad = fE[i], sE[i], tE[i], A[i], RSI[i], ADX[i]
                  if None in (fe, se, te, a, r, ad) or a <= 0:
                      continue

                  # ---- 1) open trade ka exit ----
                  t = ms.get('trade')
                  if t and bar['t'] > t['bar']:
                      hit = None
                      plab = ''
                      # (a) premium based stop -- fires on option value, not index points
                      if t.get('K') and t.get('p0') and t.get('psl'):
                          dl_ = max(t.get('dte', 3) - (bar['t'] - t['bar']) / 86400.0, 0.25)
                          pn_ = opt_leg(bar['c'], t['K'], dl_, t['side'] == 1)
                          chg_ = (pn_ - t['p0']) / t['p0'] * 100.0
                          if pn_ <= t['psl']:
                              hit = ('SL', bar['c'])
                              plab = ' \u00b7 premium {:+.0f}%'.format(chg_)
                          elif pn_ >= t['ptp']:
                              hit = ('TP', bar['c'])
                              plab = ' \u00b7 premium {:+.0f}%'.format(chg_)
                      # (b) index based SL/TP -- backstop
                      if not hit and t['side'] == 1:
                          hit = ('SL', t['sl']) if bar['l'] <= t['sl'] else (
                                ('TP', t['tp']) if bar['h'] >= t['tp'] else None)
                      elif not hit:
                          hit = ('SL', t['sl']) if bar['h'] >= t['sl'] else (
                                ('TP', t['tp']) if bar['l'] <= t['tp'] else None)
                      if not hit and (bar['t'] - t['bar']) / 60 >= M['tstop'] * M['bar_min']:
                          hit = ('TIME', bar['c'])
                      if hit:
                          rr_ = (hit[1] - t['entry']) * t['side'] / t['risk']
                          oline = ''
                          if t.get('K') and t.get('p0'):
                              dleft = t.get('dte', 3) - (bar['t'] - t['bar']) / 86400.0
                              px = opt_leg(hit[1], t['K'], dleft, t['side'] == 1)
                              oline = '\n🎫 {} {} ~₹{:,.0f} → <b>{:+.0f}%</b>'.format(
                                  t['K'], 'CE' if t['side'] == 1 else 'PE', px,
                                  (px - t['p0']) / t['p0'] * 100)
                          send(('✅' if rr_ > 0 else '❌') + ' <b>EXIT ' + hit[0] + plab + '</b>\n<b>' + name
                               + '</b> ' + tf + ' ' + ('LONG' if t['side'] == 1 else 'SHORT')
                               + ' @ <code>{:,.2f}</code>\nEntry <code>{:,.2f}</code> → Result: <b>{:+.2f}R</b>'
                               .format(hit[1], t['entry'], rr_) + oline)
                          ms['trade'] = None
                          changed = True

                  if ms.get('trade'):
                      continue

                  # ---- 2) naya signal ----
                  if i - (M['lb'] - 1) < 0:
                      continue
                  lo = min(B[k]['l'] for k in range(i - (M['lb'] - 1), i + 1))
                  hi = max(B[k]['h'] for k in range(i - (M['lb'] - 1), i + 1))
                  if a / bar['c'] * 100 <= 0.01:
                      continue
                  side = 0
                  if (bar['c'] > te and fe > se and lo <= fe * (1 + TPCT) and bar['c'] > fe
                          and bar['c'] > bar['o'] and r > 50 and ad > M['adx']):
                      side = 1
                  elif (bar['c'] < te and fe < se and hi >= fe * (1 - TPCT) and bar['c'] < fe
                          and bar['c'] < bar['o'] and r < 50 and ad > M['adx']):
                      side = -1
                  if not side:
                      continue

                  # ---- 2a) entry gate: bar gate se pehle band hua ho ----
                  end = bar_end(M, bar['t'])
                  if M['gate'] is not None and ist_min(end) > M['gate']:
                      continue
                  # ---- 2b) market khuli ho ----
                  if not market_open(M, now):
                      skipped_late += 1
                      continue
                  # ---- 2c) data bahut purana na ho ----
                  if now - end > M['maxdelay'] * 60:
                      skipped_late += 1
                      continue

                  risk = a * M['sl']
                  sl = bar['c'] - side * risk
                  tp = bar['c'] + side * risk * M['rr']
                  delay_min = (now - end) / 60

                  # ---- FRESHNESS GUARD: trade nikal chuki hai to alert mat bhejo ----
                  live = live_price(M)
                  drift = (live - bar['c']) * side if live else None
                  if drift is not None:
                      if drift <= -risk * 0.5:
                          print('{}: SKIP -- price SL ki taraf {:,.0f} pts (risk ka {:.0f}%) nikal gayi'
                                .format(name, -drift, -drift / risk * 100))
                          continue
                      if drift >= risk * M['rr'] * 0.75:
                          print('{}: SKIP -- price TP ke paas nikal gayi ({:,.0f} pts)'.format(name, drift))
                          continue

                  head = '🟢 <b>BUY SIGNAL</b> 🟢' if side == 1 else '🔴 <b>SELL SIGNAL</b> 🔴'
                  m = [head, '', '<b>' + name + '</b> · ' + tf + ' · Gold Sniper Engine', '─' * 24]
                  m += [('▲' if side == 1 else '▼') + ' <b>Entry</b>  <code>{:,.2f}</code>'.format(bar['c']),
                        '🛑 <b>SL</b>     <code>{:,.2f}</code>'.format(sl),
                        '🎯 <b>TP</b>     <code>{:,.2f}</code>'.format(tp),
                        '⚖️ <b>RR</b>     1:{:g}'.format(M['rr']),
                        '📏 <b>Risk</b>   {:,.2f} pts ({:g}×ATR)'.format(risk, M['sl']),
                        '📐 <b>DIST</b>   SL {:,.2f} · TP {:,.2f}'.format(risk, risk * M['rr']),
                        '─' * 24]
                  if drift is not None:
                      if drift < -risk * 0.25:
                          m.insert(len(m) - 1, '\u26a0\ufe0f <b>LATE:</b> live {:,.2f} ({:+,.0f} pts = {:+.0f}% risk) -- entry kamzor'.format(live, drift, drift / risk * 100))
                      else:
                          m.insert(len(m) - 1, '\u2705 <b>Entry abhi valid</b> \u00b7 live {:,.2f} ({:+,.0f} pts)'.format(live, drift))
                  parts = []
                  for lab, pv, cur in M['units']:
                      v = risk * pv
                      parts.append(lab + ' ' + ('₹{:,.0f}'.format(v) if cur == 'INR' else '${:,.0f}'.format(v)))
                  m.append('💰 ' + ' · '.join(parts))
                  tgt = BAL * RP / 100
                  usd = [(l, v) for l, v, cu in M['units'] if cu == 'USD']
                  if usd:
                      lab, pv = usd[0]
                      val = risk * pv
                      if val > tgt:
                          m.append('⚠️ <b>NOTE:</b> min size ({}) par risk <b>${:,.0f}</b> = <b>{:.1f}%</b> of {:,.0f}.'
                                   .format(lab, val, val / BAL * 100, BAL))
                      else:
                          m.append('🎯 Target risk ${:,.0f} → <b>{:.2f} unit</b>'
                                   .format(tgt, math.floor(tgt / val * 100) / 100))
                  else:
                      m.append('🎯 Target risk ₹{:,.0f} → 1 lot se {:,.0f} (apne account se compare karein)'
                               .format(tgt, risk * M['units'][0][1]))
                  K, p0 = 0, 0.0
                  if M.get('opt'):
                      oq, ost, ootm = M['opt']
                      K = int(round(bar['c'] / ost) * ost + ootm * ost * side)   # + = OTM
                      mlab = 'ATM' if ootm == 0 else 'OTM{}'.format(ootm)
                      call = side == 1
                      exp_d, dte, exp_note = expiry_for(name, datetime.fromtimestamp(now, IST), B)
                      p0 = opt_leg(bar['c'], K, dte, call)
                      ps = opt_leg(sl, K, dte, call)
                      pt = opt_leg(tp, K, dte, call)
                      m += ['─' * 24,
                            '📈 <b>OPTION MODE</b> · ' + ('BUY CALL (CE)' if call else 'BUY PUT (PE)'),
                            '🎫 Strike <code>{:,} {}</code>   ({} · {} · {} din)'.format(
                                K, 'CE' if call else 'PE', mlab,
                                exp_d.strftime('%d-%b') if exp_d else '?', dte),
                            '💵 Premium ~<code>₹{:,.0f}</code>   → 1 lot = <b>₹{:,.0f}</b>'.format(p0, p0 * oq),
                            '🛑 SL par option ~₹{:,.0f}   ({:+.0f}%)'.format(ps, (ps - p0) / p0 * 100),
                            '\U0001f512 Premium stop \u20b9{:,.0f} ({:+.0f}%) \u00b7 target \u20b9{:,.0f} ({:+.0f}%) -- jo PEHLE aaye'.format(
                                p0 * (1 - PSL), -PSL * 100, p0 * (1 + PTP), PTP * 100),
                            '🎯 TP par option ~₹{:,.0f}   ({:+.0f}%)'.format(pt, (pt - p0) / p0 * 100),
                            '⏱ Bot ka EXIT message aate hi nikal jao.']
                      if exp_note:
                          m.append('⌛ ' + exp_note)
                      m.append('<i>Premium = BS estimate (IV {:.0f}%), asli quote nahi. '
                               'VIX high ho to signal chhod dein.</i>'.format(IV_OPT * 100))
                  m.append('─' * 24)
                  m.append('⏰ Bar band: <b>{}</b> IST · alert {:.0f} min baad'
                           .format(datetime.fromtimestamp(end, IST).strftime('%H:%M'), delay_min))
                  if M['sess']:
                      left = (close_ts_of_day(now, M['sess']) - now) / 60
                      m.append('⏳ Close tak bacha: <b>{}</b>'.format(hm(left)))
                  m += ['📊 RSI {:.1f} · EMA{} {:,.2f} · EMA{} {:,.2f} · ADX {:.1f}'
                        .format(r, M['ef'], fe, M['es'], se, ad),
                        '🕐 {} UTC'.format(datetime.fromtimestamp(now, timezone.utc).strftime('%Y-%m-%d %H:%M')),
                        '',
                        '<i>Levels index par. Broker par DIST use karein.</i>',
                        '<i>' + M['note'] + '</i>',
                        '<i>Verified: ' + M['verified'] + '</i>']
                  send('\n'.join(m))
                  ms['trade'] = {'side': side, 'entry': bar['c'], 'sl': sl, 'tp': tp,
                                 'risk': risk, 'bar': bar['t'], 'K': K, 'p0': p0,
                                 'psl': (p0 * (1.0 - PSL) if M.get('opt') else 0.0),
                                 'ptp': (p0 * (1.0 + PTP) if M.get('opt') else 0.0),
                                 'dte': (dte if M.get('opt') else 3)}
                  changed = True
                  fired += 1
                  print(name, 'SIGNAL SENT')

              ms['last'] = B[-1]['t']
              changed = True
              if not fired:
                  extra = ' ({} late skip)'.format(skipped_late) if skipped_late else ''
                  print('{}: no new signal{}'.format(name, extra))

              if skipped_late and not fired:
                  send('ℹ️ <b>' + name + '</b> ' + tf + ': ' + str(skipped_late)
                       + ' signal mile par <b>' + ('market band ho gaya' if not market_open(M, now)
                       else 'data ' + str(M['maxdelay']) + '+ min late') + '</b> — chhod diya. '
                       'Purana entry dena galat hota.', dry='quiet')

          if changed:
              json.dump(st, open(STATE, 'w'), indent=1)
              print('state saved')
          ENDOFPY
          python3 /tmp/bot.py

      - name: State save
        run: |
          if [ -f state_index_v2.json ]; then
            git config user.name "bot"
            git config user.email "bot@users.noreply.github.com"
            git add state_index_v2.json
            if ! git diff --staged --quiet; then
              git commit -m "state index v2"
              git pull --rebase --autostash || true
              git push || true
            fi
          fi
